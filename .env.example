# =============================================================================
# Loja da Joaninha — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha. Nada aqui vai para o git.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Painel do projeto > Settings > API
# -----------------------------------------------------------------------------
# URL do projeto (ex: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon / public". Pode aparecer no navegador — o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role". SEGREDO. Nunca use com NEXT_PUBLIC_, nunca comite.
# É usada só no servidor, para gravar o pedido e ler o pedido pelo código.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# E-MAIL (SMTP) — os e-mails saem do Gmail da própria loja
#
# Por que Gmail e não um serviço tipo Resend: sem domínio próprio, esses
# serviços só entregam para o dono da conta, e o aviso de status para o CLIENTE
# nunca chegaria. Pelo Gmail da loja, ela e os clientes recebem normalmente.
#
# Como gerar a senha (uma vez só, na conta Google da loja):
#   1. myaccount.google.com > Segurança
#   2. ative a Verificação em duas etapas (obrigatório para o passo seguinte)
#   3. procure por "Senhas de app" e crie uma com o nome "Loja"
#   4. o Google mostra 16 letras — cole abaixo, pode ser com ou sem espaços
#
# ATENÇÃO: é a senha de app, NUNCA a senha normal da conta Google.
# -----------------------------------------------------------------------------
SMTP_USER=
SMTP_PASSWORD=

# Só mexa nestes dois se for usar outro provedor que não o Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Para onde vai o aviso de pedido novo, caso a Joaninha ainda não tenha
# preenchido o e-mail em Configurações no painel. O painel tem prioridade.
EMAIL_TO_ADMIN=

# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
# Endereço público do site, sem barra no fim. Usado nos links dos e-mails.
# Local: http://localhost:3000   |   Produção: https://sua-loja.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
